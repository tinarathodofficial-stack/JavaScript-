---
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Master the fundamentals of JavaScript with interactive code play and clean developer explanations.",
} = Astro.props;
import "../styles/global.css";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<div class="container nav-container">
				<a href={baseUrl} class="logo-wrapper">
					<div class="logo-icon">JS</div>
					<div class="logo-text">JavaScript<span>Basics</span></div>
				</a>
				<nav>
					<ul class="nav-links">
						<li><a href={`${baseUrl}#timeline`}>History</a></li>
						<li><a href={`${baseUrl}tc39`}>About TC39</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<slot />

		<footer>
			<div class="container">
				<p>
					© {new Date().getFullYear()} JavaScript Basics. Built for developers
					eager to learn.
				</p>
				<!-- <div class="social-links">
					<a
						href="https://github.com"
						target="_blank"
						rel="noopener noreferrer">GitHub</a
					>
					<a
						href="https://astro.build"
						target="_blank"
						rel="noopener noreferrer">Astro</a
					>
					<a
						href="https://twitter.com"
						target="_blank"
						rel="noopener noreferrer">Twitter</a
					>
				</div> -->
			</div>
		</footer>
	</body>
</html>
